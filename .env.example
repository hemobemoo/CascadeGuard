# Copy to .env, fill in, and NEVER commit .env (add it to .gitignore).
# Claude Code reads these from your shell environment, so load them before
# starting it, e.g.:  set -a; source .env; set +a; claude

# Free key from https://context7.com/dashboard (optional, raises rate limits)
CONTEXT7_API_KEY=

# Fine-grained GitHub token limited to the CascadeGuard repo ONLY.
# Permissions: Contents (read/write), Issues (read/write),
# Pull requests (read/write), Metadata (read). Expiry: end of hackathon.
GITHUB_PAT=

# From https://firecrawl.dev (free tier is enough for scenario research)
FIRECRAWL_API_KEY=

# Only needed once Phoenix is running (pip install arize-phoenix; phoenix serve)
PHOENIX_BASE_URL=http://localhost:6006

# Choose the model to use for the LLM phase of the pipeline, including the API key, base URL, and the model's name.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
