# Copy to .env and fill in. Never commit .env.
# LLM agents (Phase 5) use OpenRouter through the openai SDK.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CASCADEGUARD_MODEL=your-chosen-model-id
# json_schema (default: strict structured output) or json_object (JSON mode, schema in the
# prompt; only for models without structured outputs). Never switched automatically.
CASCADEGUARD_OUTPUT_MODE=json_schema
# Optional pacing and retries for failed requests (code defaults shown).
CASCADEGUARD_REQUESTS_PER_MINUTE=15
CASCADEGUARD_REQUEST_RETRIES=3
CASCADEGUARD_BACKOFF_SECONDS=5,15,45
